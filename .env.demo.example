# ApexCore ERP — Oracle Cloud / public demo
# Copy to .env on the server:  cp .env.demo.example .env
# Then replace every CHANGE_ME value before first start.

# Public URL clients will open (no trailing slash)
# Examples: http://129.146.x.x   or   https://demo.yourdomain.com
PUBLIC_URL=http://CHANGE_ME_PUBLIC_IP
FRONTEND_URL=http://CHANGE_ME_PUBLIC_IP

# Strong secrets (generate on the server with: openssl rand -base64 48)
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS
DATA_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_ENCRYPTION_KEY_HERE

# MySQL (demo — change before sharing widely)
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=filter_erp
MYSQL_USER=erp_user
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD

# Seed platform owner on first boot (set SEED_ON_START=false after first successful login)
SEED_ON_START=true
SEED_PRODUCTION=true
SEED_ADMIN_PASSWORD=DemoClient@2026!
PLATFORM_COMPANY_SLUG=owner
PLATFORM_OWNER_EMAIL=demo@apexcore.co.ke
PLATFORM_OWNER_PASSWORD=DemoClient@2026!

# Integrations off for demo
MPESA_ENV=stub
SWAGGER_ENABLED=false
TZ=Africa/Nairobi
NODE_ENV=production
