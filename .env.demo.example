# AbexCore ERP — demo subdomain on same Contabo VPS as production
# Separate clone: ~/Abexcore-demo   Separate DB/volumes — does not touch live data.
#
#   cp .env.demo.example .env
#   # Generate secrets (openssl rand -base64 48), set passwords, then:
#   docker compose -p abexcore-demo -f docker-compose.yml -f docker-compose.demo.yml --env-file .env up -d --build

PUBLIC_URL=https://demo.abexcore.co.ke
FRONTEND_URL=https://demo.abexcore.co.ke
CORS_EXTRA_ORIGINS=

# Demo app listens on localhost only; production Caddy terminates HTTPS.
FRONTEND_HOST_BIND=127.0.0.1:8081

NODE_ENV=production
TZ=Africa/Nairobi

JWT_SECRET=CHANGE_ME_DEMO_JWT_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_DEMO_REFRESH_SECRET_MIN_32_CHARS
DATA_ENCRYPTION_KEY=CHANGE_ME_DEMO_32_CHAR_ENCRYPTION_KEY

MYSQL_ROOT_PASSWORD=CHANGE_ME_DEMO_ROOT_PASSWORD
MYSQL_DATABASE=filter_erp_demo
MYSQL_USER=erp_demo_user
MYSQL_PASSWORD=CHANGE_ME_DEMO_DB_PASSWORD

SEED_ON_START=true
SEED_PRODUCTION=false
SEED_ADMIN_PASSWORD=CHANGE_ME_DEMO_ADMIN_PASSWORD
PLATFORM_COMPANY_SLUG=owner
PLATFORM_OWNER_EMAIL=demo@abexcore.co.ke
PLATFORM_OWNER_PASSWORD=CHANGE_ME_DEMO_OWNER_PASSWORD

AUDIT_LOG_RETENTION_DAYS=7
MPESA_ENV=stub
SWAGGER_ENABLED=true
USE_DB_PUSH=true

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AbexCore Demo <noreply@abexcore.co.ke>
