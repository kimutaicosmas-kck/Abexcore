    "db:seed:production": "tsx prisma/seed.production.ts",
    "db:purge-legacy": "tsx scripts/purge-legacy-tenants.ts",
    "db:studio": "prisma studio",
    "openapi:generate": "tsx scripts/generate-openapi-paths.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
