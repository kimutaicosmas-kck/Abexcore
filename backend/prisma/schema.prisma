generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CustomerType {
  DEALER
  RETAIL_SHOP
  INDUSTRY
  GOVERNMENT
  NGO
}

/** Whether the customer is VAT-registered (taxable invoices) or Non-VAT (0% tax invoices). */
enum CustomerVatStatus {
  VAT
  NON_VAT
}

enum ApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  IN_PRODUCTION
  READY
  PARTIALLY_DELIVERED
  DISPATCHED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum ProductionStatus {
  PLANNED
  SCHEDULED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum QualityStatus {
  PENDING
  PASSED
  FAILED
  CONDITIONAL
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
  REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  MPESA
  COOP_PAYBILL
  CARD
  CREDIT
}

enum FiscalStatus {
  NOT_REQUIRED
  PENDING
  SUBMITTED
  FAILED
}

enum ExpenseStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  POSTED
  VOIDED
}

enum MpesaTransactionStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum BankLineMatchStatus {
  UNMATCHED
  MATCHED
  IGNORED
}

enum InvoiceType {
  SALES
  PURCHASE
  CREDIT_NOTE
  DEBIT_NOTE
}

enum TransactionType {
  RECEIPT
  ISSUE
  TRANSFER
  ADJUSTMENT
  RETURN
  PRODUCTION_CONSUMPTION
  PRODUCTION_OUTPUT
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum Gender {
  MALE
  FEMALE
  UNSPECIFIED
}

enum SalaryAdvanceStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
  WRITTEN_OFF
}

enum SalaryAdvanceRepaymentMethod {
  PAYROLL
  CASH
  BANK_TRANSFER
  MPESA
  MANUAL
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

enum VehicleType {
  MOTORCYCLE
  TRUCK
  LORRY
}

enum NotificationType {
  APPROVAL
  LOW_STOCK
  OVERDUE_PAYMENT
  PRODUCTION_DELAY
  MAINTENANCE
  DELIVERY
  SYSTEM
}

// ==================== COMPANY & SETTINGS ====================

model Company {
  id             String   @id @default(uuid())
  slug           String   @unique
  name           String
  legalName      String?  @map("legal_name")
  registrationNo String?  @map("registration_no")
  taxPin         String?  @map("tax_pin")
  logo           String?
  address        String?  @db.Text
  city           String?
  country        String   @default("Kenya")
  phone          String?
  email          String?
  website        String?
  currency       String   @default("KES")
  financialYearStart Int  @default(1) @map("financial_year_start")
  vatRate        Decimal  @default(16) @map("vat_rate") @db.Decimal(5, 2)
  customerVatRate Decimal @default(2) @map("customer_vat_rate") @db.Decimal(5, 2)
  companyVatRate  Decimal @default(14) @map("company_vat_rate") @db.Decimal(5, 2)
  qualityModuleEnabled Boolean @default(false) @map("quality_module_enabled")
  /** Package modules for this tenant. null = full manufacturing suite (legacy). */
  enabledModules Json? @map("enabled_modules")
  coopPaybillNumber String? @map("coop_paybill_number")
  /** M-Pesa paybill account number printed on delivery notes / invoices. */
  mpesaAccountNumber String? @map("mpesa_account_number")
  /** Shown once after login in the welcome ceremony. Unique per tenant. */
  welcomeMessage String? @map("welcome_message") @db.VarChar(280)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  branches Branch[]
  taxRates TaxRate[]
  users    User[]
  departments Department[]

  @@map("companies")
}

model Branch {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  code      String
  address   String?  @db.Text
  phone     String?
  email     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  company    Company     @relation(fields: [companyId], references: [id])
  warehouses Warehouse[]
  users      User[]
  employees  Employee[]

  @@unique([companyId, code])
  @@map("branches")
}

model TaxRate {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  rate      Decimal  @db.Decimal(5, 2)
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])

  @@map("tax_rates")
}

model EmailConfig {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  host      String
  port      Int      @default(587)
  secure    Boolean  @default(false)
  username  String
  password  String
  fromEmail String   @map("from_email")
  fromName  String   @map("from_name")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("email_configs")
}

// ==================== USER MANAGEMENT ====================

model Department {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  name        String
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company   Company    @relation(fields: [companyId], references: [id])
  users     User[]
  employees Employee[]

  @@unique([companyId, name])
  @@map("departments")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?  @db.Text
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id              String     @id @default(uuid())
  companyId       String     @map("company_id")
  email           String
  passwordHash    String     @map("password_hash")
  firstName       String     @map("first_name")
  lastName        String     @map("last_name")
  phone           String?
  avatar          String?
  roleId          String     @map("role_id")
  departmentId    String?    @map("department_id")
  branchId        String?    @map("branch_id")
  status          UserStatus @default(ACTIVE)
  twoFactorEnabled Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret  String?   @map("two_factor_secret")
  mustChangePassword Boolean @default(false) @map("must_change_password")
  /** Optional per-user module list; when set, overrides role module defaults for permissions. */
  allowedModules  Json?     @map("allowed_modules")
  lastLoginAt     DateTime?  @map("last_login_at")
  passwordChangedAt DateTime? @map("password_changed_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  company    Company     @relation(fields: [companyId], references: [id])
  role       Role        @relation(fields: [roleId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  branch     Branch?     @relation(fields: [branchId], references: [id])

  refreshTokens    RefreshToken[]
  loginHistory     LoginHistory[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  purchaseReqs     PurchaseRequisition[] @relation("CreatedByUser")
  approvedReqs     PurchaseRequisition[] @relation("ApprovedByUser")
  salesOrders      SalesOrder[]      @relation("SalesOrderCreator")
  assignedSalesOrders SalesOrder[]   @relation("SalesOrderSalesPerson")
  assignedCustomers Customer[]       @relation("CustomerSalesPerson")
  salesTargets     SalesTarget[]
  productionOrders ProductionOrder[]
  assignedDeliveries DeliveryNote[] @relation("DeliveryDriver")
  assignedDeliveryTrips DeliveryTrip[] @relation("DeliveryTripDriver")
  salesReturnsCreated SalesReturn[] @relation("SalesReturnCreator")
  employee              Employee?
  leaveRequestsRequested LeaveRequest[] @relation("LeaveRequestedBy")
  leaveRequestsApproved  LeaveRequest[] @relation("LeaveApprovedBy")
  leaveBalancesUpdated   LeaveBalance[] @relation("LeaveBalanceUpdatedBy")
  salaryAdvancesCreated  SalaryAdvance[] @relation("SalaryAdvanceCreatedBy")
  salaryAdvancesApproved SalaryAdvance[] @relation("SalaryAdvanceApprovedBy")
  salaryAdvanceRepaymentsRecorded SalaryAdvanceRepayment[] @relation("SalaryAdvanceRepaymentRecordedBy")
  ssoIdentities          UserSsoIdentity[]
  approvalsRequested     ApprovalRequest[] @relation("ApprovalRequestedBy")
  approvalsDecided       ApprovalRequest[] @relation("ApprovalDecidedBy")
  expensesSubmitted      Expense[] @relation("ExpenseSubmittedBy")
  expensesApproved       Expense[] @relation("ExpenseApprovedBy")

  @@unique([companyId, email])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent") @db.Text
  success   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("login_history")
}

model AuditLog {
  id         String   @id @default(uuid())
  companyId  String   @map("company_id")
  userId     String?  @map("user_id")
  action     String
  module     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([module, entityType, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String           @id @default(uuid())
  companyId String           @map("company_id")
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String           @db.Text
  link      String?
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ==================== CRM ====================

model Customer {
  id           String       @id @default(uuid())
  companyId    String       @map("company_id")
  code         String
  name         String
  type         CustomerType @default(DEALER)
  email        String?
  phone        String?
  address      String?      @db.Text
  city         String?
  country      String       @default("Kenya")
  taxPin       String?      @map("tax_pin")
  /** VAT = charge company VAT on invoices; NON_VAT = company still invoices at 0% VAT. */
  vatStatus    CustomerVatStatus @default(NON_VAT) @map("vat_status")
  creditLimit  Decimal      @default(0) @map("credit_limit") @db.Decimal(15, 2)
  creditUsed   Decimal      @default(0) @map("credit_used") @db.Decimal(15, 2)
  paymentTerms Int          @default(30) @map("payment_terms")
  /** Optional owning sales officer; null = unassigned / house account. */
  salesPersonId String?     @map("sales_person_id")
  isActive     Boolean      @default(true) @map("is_active")
  notes        String?      @db.Text
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")

  salesPerson   User?             @relation("CustomerSalesPerson", fields: [salesPersonId], references: [id], onDelete: SetNull)
  contacts      CustomerContact[]
  quotations    SalesQuotation[]
  salesOrders   SalesOrder[]
  invoices      Invoice[]
  complaints    Complaint[]
  warranties    Warranty[]
  opportunities Opportunity[]

  @@unique([companyId, code])
  @@index([deletedAt, isActive])
  @@index([name])
  @@index([salesPersonId])
  @@index([vatStatus])
  @@map("customers")
}

model CustomerContact {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  name       String
  title      String?
  email      String?
  phone      String?
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_contacts")
}

model Opportunity {
  id          String         @id @default(uuid())
  companyId   String         @map("company_id")
  customerId  String         @map("customer_id")
  title       String
  value       Decimal        @db.Decimal(15, 2)
  stage       String         @default("prospecting")
  probability Int            @default(10)
  expectedCloseDate DateTime? @map("expected_close_date")
  notes       String?        @db.Text
  status      ApprovalStatus @default(PENDING)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([companyId])
  @@map("opportunities")
}

model Complaint {
  id          String         @id @default(uuid())
  companyId   String         @map("company_id")
  customerId  String         @map("customer_id")
  subject     String
  description String         @db.Text
  priority    String         @default("medium")
  status      ApprovalStatus @default(PENDING)
  resolution  String?        @db.Text
  resolvedAt  DateTime?      @map("resolved_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([companyId])
  @@map("complaints")
}

model Warranty {
  id           String   @id @default(uuid())
  customerId   String   @map("customer_id")
  productId    String   @map("product_id")
  serialNumber String?  @map("serial_number")
  startDate    DateTime @map("start_date")
  endDate      DateTime @map("end_date")
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@map("warranties")
}

// ==================== SUPPLIERS ====================

model Supplier {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  code          String
  name          String
  email         String?
  phone         String?
  address       String?  @db.Text
  city          String?
  country       String   @default("Kenya")
  taxPin        String?  @map("tax_pin")
  paymentTerms  Int      @default(30) @map("payment_terms")
  leadTimeDays  Int      @default(7) @map("lead_time_days")
  rating        Decimal  @default(0) @db.Decimal(3, 2)
  isActive      Boolean  @default(true) @map("is_active")
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  rawMaterials      RawMaterial[]
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]
  supplierInvoices  Invoice[] @relation("SupplierInvoices")
  contracts         SupplierContract[]
  quotations        SupplierQuotation[]
  expenses          Expense[]

  @@unique([companyId, code])
  @@map("suppliers")
}

model SupplierContract {
  id         String   @id @default(uuid())
  supplierId String   @map("supplier_id")
  title      String
  startDate  DateTime @map("start_date")
  endDate    DateTime @map("end_date")
  terms      String?  @db.Text
  documentUrl String? @map("document_url")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@map("supplier_contracts")
}

// ==================== PRODUCTS & RAW MATERIALS ====================

model ProductCategory {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("product_categories")
}

model Product {
  id               String          @id @default(uuid())
  companyId        String          @map("company_id")
  sku              String
  barcode          String?
  name             String
  categoryId       String          @map("category_id")
  description      String?         @db.Text
  weight           Decimal?        @db.Decimal(10, 3)
  length           Decimal?        @db.Decimal(10, 2)
  width            Decimal?        @db.Decimal(10, 2)
  height           Decimal?        @db.Decimal(10, 2)
  imageUrl         String?         @map("image_url")
  manufacturingCost Decimal        @default(0) @map("manufacturing_cost") @db.Decimal(15, 2)
  sellingPrice     Decimal         @default(0) @map("selling_price") @db.Decimal(15, 2)
  distributorPrice Decimal         @default(0) @map("distributor_price") @db.Decimal(15, 2)
  retailPrice      Decimal         @default(0) @map("retail_price") @db.Decimal(15, 2)
  minStockLevel    Int             @default(0) @map("min_stock_level")
  isImported       Boolean         @default(false) @map("is_imported")
  requiresProduction Boolean       @default(false) @map("requires_production")
  isActive         Boolean         @default(true) @map("is_active")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  deletedAt        DateTime?       @map("deleted_at")

  category         ProductCategory @relation(fields: [categoryId], references: [id])
  bom              BillOfMaterial?
  stockLevels      StockLevel[]
  salesOrderItems  SalesOrderItem[]
  quotationItems   QuotationItem[]
  productionOrders ProductionOrder[]
  warranties       Warranty[]
  qualityInspections QualityInspection[]
  salesReturnItems SalesReturnItem[]

  @@unique([companyId, sku])
  @@unique([companyId, barcode])
  @@index([deletedAt, isActive])
  @@index([categoryId])
  @@map("products")
}

model MaterialType {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  materials RawMaterial[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("material_types")
}

model RawMaterial {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  code          String
  name          String
  typeId        String   @map("type_id")
  description   String?  @db.Text
  unit          String          @default("pcs")
  unitCost      Decimal         @default(0) @map("unit_cost") @db.Decimal(15, 4)
  /** Unit weight in kg (optional). */
  weight        Decimal?        @db.Decimal(10, 3)
  supplierId    String?         @map("supplier_id")
  minStockLevel Decimal         @default(0) @map("min_stock_level") @db.Decimal(15, 3)
  reorderQty    Decimal         @default(0) @map("reorder_qty") @db.Decimal(15, 3)
  shelfLifeDays Int?            @map("shelf_life_days")
  isActive      Boolean         @default(true) @map("is_active")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  deletedAt     DateTime?       @map("deleted_at")

  materialType         MaterialType           @relation(fields: [typeId], references: [id])
  supplier             Supplier?              @relation(fields: [supplierId], references: [id])
  stockLevels          StockLevel[]
  bomItems             BillOfMaterialItem[]
  productionConsumption ProductionConsumption[]

  @@unique([companyId, code])
  @@index([typeId])
  @@map("raw_materials")
}

model BillOfMaterial {
  id        String   @id @default(uuid())
  productId String   @unique @map("product_id")
  version   String   @default("1.0")
  isActive  Boolean  @default(true) @map("is_active")
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product              @relation(fields: [productId], references: [id])
  items   BillOfMaterialItem[]

  @@map("bill_of_materials")
}

model BillOfMaterialItem {
  id             String  @id @default(uuid())
  bomId          String  @map("bom_id")
  rawMaterialId  String  @map("raw_material_id")
  quantity       Decimal @db.Decimal(15, 4)
  unit           String  @default("pcs")
  wastePercent   Decimal @default(0) @map("waste_percent") @db.Decimal(5, 2)
  notes          String?

  bom         BillOfMaterial @relation(fields: [bomId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial    @relation(fields: [rawMaterialId], references: [id])

  @@map("bill_of_material_items")
}

// ==================== WAREHOUSE & INVENTORY ====================

model Warehouse {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  branchId  String   @map("branch_id")
  code      String
  name      String
  type      String   @default("general")
  address   String?  @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  branch    Branch             @relation(fields: [branchId], references: [id])
  locations WarehouseLocation[]
  stockLevels StockLevel[]
  transactions InventoryTransaction[]

  @@unique([companyId, code])
  @@map("warehouses")
}

model WarehouseLocation {
  id          String   @id @default(uuid())
  warehouseId String   @map("warehouse_id")
  code        String
  name        String
  aisle       String?
  rack        String?
  bin         String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, code])
  @@map("warehouse_locations")
}

model StockLevel {
  id            String    @id @default(uuid())
  warehouseId   String    @map("warehouse_id")
  productId     String?   @map("product_id")
  rawMaterialId String?   @map("raw_material_id")
  batchNumber   String?   @map("batch_number")
  quantity      Decimal   @default(0) @db.Decimal(15, 3)
  reservedQty   Decimal   @default(0) @map("reserved_qty") @db.Decimal(15, 3)
  unitCost      Decimal   @default(0) @map("unit_cost") @db.Decimal(15, 4)
  expiryDate    DateTime? @map("expiry_date")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id])
  product     Product?     @relation(fields: [productId], references: [id])
  rawMaterial RawMaterial? @relation(fields: [rawMaterialId], references: [id])

  @@index([warehouseId, productId])
  @@index([warehouseId, rawMaterialId])
  @@map("stock_levels")
}

model InventoryTransaction {
  id              String          @id @default(uuid())
  warehouseId     String          @map("warehouse_id")
  type            TransactionType
  productId       String?         @map("product_id")
  rawMaterialId   String?         @map("raw_material_id")
  batchNumber     String?         @map("batch_number")
  quantity        Decimal         @db.Decimal(15, 3)
  unitCost        Decimal         @default(0) @map("unit_cost") @db.Decimal(15, 4)
  referenceType   String?         @map("reference_type")
  referenceId     String?         @map("reference_id")
  notes           String?         @db.Text
  createdById     String?         @map("created_by_id")
  createdAt       DateTime        @default(now()) @map("created_at")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([warehouseId, createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_transactions")
}

// ==================== PROCUREMENT ====================

model PurchaseRequisition {
  id            String         @id @default(uuid())
  companyId     String         @map("company_id")
  requisitionNo String         @map("requisition_no")
  requestedById String         @map("requested_by_id")
  department    String?
  priority      String         @default("normal")
  requiredDate  DateTime?      @map("required_date")
  status        ApprovalStatus @default(DRAFT)
  approvedById  String?        @map("approved_by_id")
  approvedAt    DateTime?      @map("approved_at")
  notes         String?        @db.Text
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  requestedBy User  @relation("CreatedByUser", fields: [requestedById], references: [id])
  approvedBy  User? @relation("ApprovedByUser", fields: [approvedById], references: [id])
  items       PurchaseRequisitionItem[]
  rfqs        RequestForQuotation[]

  @@unique([companyId, requisitionNo])
  @@map("purchase_requisitions")
}

model PurchaseRequisitionItem {
  id              String  @id @default(uuid())
  requisitionId   String  @map("requisition_id")
  rawMaterialId   String? @map("raw_material_id")
  description     String
  quantity        Decimal @db.Decimal(15, 3)
  unit            String  @default("pcs")
  estimatedCost   Decimal @default(0) @map("estimated_cost") @db.Decimal(15, 2)

  requisition PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  @@map("purchase_requisition_items")
}

model RequestForQuotation {
  id            String         @id @default(uuid())
  companyId     String         @map("company_id")
  rfqNo         String         @map("rfq_no")
  requisitionId String?        @map("requisition_id")
  dueDate       DateTime?      @map("due_date")
  status        ApprovalStatus @default(PENDING)
  notes         String?        @db.Text
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  requisition PurchaseRequisition? @relation(fields: [requisitionId], references: [id])
  quotations  SupplierQuotation[]

  @@unique([companyId, rfqNo])
  @@map("request_for_quotations")
}

model SupplierQuotation {
  id         String         @id @default(uuid())
  rfqId      String         @map("rfq_id")
  supplierId String         @map("supplier_id")
  totalAmount Decimal       @default(0) @map("total_amount") @db.Decimal(15, 2)
  validUntil DateTime?      @map("valid_until")
  status     ApprovalStatus @default(PENDING)
  notes      String?        @db.Text
  createdAt  DateTime       @default(now()) @map("created_at")

  rfq      RequestForQuotation @relation(fields: [rfqId], references: [id])
  supplier Supplier            @relation(fields: [supplierId], references: [id])
  purchaseOrders PurchaseOrder[]

  @@map("supplier_quotations")
}

model PurchaseOrder {
  id           String         @id @default(uuid())
  companyId    String         @map("company_id")
  poNumber     String         @map("po_number")
  supplierId   String         @map("supplier_id")
  quotationId  String?        @map("quotation_id")
  orderDate    DateTime       @default(now()) @map("order_date")
  expectedDate DateTime?      @map("expected_date")
  status       OrderStatus    @default(PENDING)
  subtotal     Decimal        @default(0) @db.Decimal(15, 2)
  taxAmount    Decimal        @default(0) @map("tax_amount") @db.Decimal(15, 2)
  totalAmount  Decimal        @default(0) @map("total_amount") @db.Decimal(15, 2)
  notes        String?        @db.Text
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  supplier  Supplier           @relation(fields: [supplierId], references: [id])
  quotation SupplierQuotation? @relation(fields: [quotationId], references: [id])
  items     PurchaseOrderItem[]
  receipts  GoodsReceipt[]
  invoices      Invoice[]

  @@unique([companyId, poNumber])
  @@index([status])
  @@index([supplierId])
  @@index([orderDate])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(uuid())
  purchaseOrderId String  @map("purchase_order_id")
  rawMaterialId   String? @map("raw_material_id")
  description     String
  quantity        Decimal @db.Decimal(15, 3)
  receivedQty     Decimal @default(0) @map("received_qty") @db.Decimal(15, 3)
  unit            String  @default("pcs")
  unitPrice       Decimal @default(0) @map("unit_price") @db.Decimal(15, 4)
  totalPrice      Decimal @default(0) @map("total_price") @db.Decimal(15, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              String         @id @default(uuid())
  companyId       String         @map("company_id")
  grnNumber       String         @map("grn_number")
  purchaseOrderId String?        @map("purchase_order_id")
  supplierId      String         @map("supplier_id")
  warehouseId     String         @map("warehouse_id")
  receiptDate     DateTime       @default(now()) @map("receipt_date")
  status          ApprovalStatus @default(PENDING)
  inspectionStatus QualityStatus @default(PENDING) @map("inspection_status")
  notes           String?        @db.Text
  createdAt       DateTime       @default(now()) @map("created_at")

  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  items         GoodsReceiptItem[]
  inspections   QualityInspection[]
  invoices      Invoice[]

  @@unique([companyId, grnNumber])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id             String  @id @default(uuid())
  goodsReceiptId String  @map("goods_receipt_id")
  rawMaterialId  String? @map("raw_material_id")
  batchNumber    String? @map("batch_number")
  quantity       Decimal @db.Decimal(15, 3)
  unit           String  @default("pcs")
  unitCost       Decimal @default(0) @map("unit_cost") @db.Decimal(15, 4)
  expiryDate     DateTime? @map("expiry_date")

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)

  @@map("goods_receipt_items")
}

// ==================== PRODUCTION ====================

model Machine {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  code            String
  name            String
  type            String
  capacity        String?
  location        String?
  status          String   @default("operational")
  lastMaintenance DateTime? @map("last_maintenance")
  nextMaintenance DateTime? @map("next_maintenance")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  productionOrders ProductionOrder[]
  maintenanceRequests MaintenanceRequest[]

  @@unique([companyId, code])
  @@map("machines")
}

model ProductionOrder {
  id              String           @id @default(uuid())
  companyId       String           @map("company_id")
  orderNumber     String           @map("order_number")
  productId       String           @map("product_id")
  salesOrderId    String?          @map("sales_order_id")
  machineId       String?          @map("machine_id")
  assignedToId    String?          @map("assigned_to_id")
  quantity        Int
  completedQty    Int              @default(0) @map("completed_qty")
  rejectedQty     Int              @default(0) @map("rejected_qty")
  status          ProductionStatus @default(PLANNED)
  priority        String           @default("normal")
  scheduledStart  DateTime?        @map("scheduled_start")
  scheduledEnd    DateTime?        @map("scheduled_end")
  actualStart     DateTime?        @map("actual_start")
  actualEnd       DateTime?        @map("actual_end")
  estimatedCost   Decimal          @default(0) @map("estimated_cost") @db.Decimal(15, 2)
  actualCost      Decimal          @default(0) @map("actual_cost") @db.Decimal(15, 2)
  notes           String?          @db.Text
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  product      Product  @relation(fields: [productId], references: [id])
  salesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id])
  machine      Machine? @relation(fields: [machineId], references: [id])
  assignedTo   User?    @relation(fields: [assignedToId], references: [id])
  batches      ProductionBatch[]
  consumption  ProductionConsumption[]
  inspections  QualityInspection[]

  @@unique([companyId, orderNumber])
  @@map("production_orders")
}

model ProductionBatch {
  id                String   @id @default(uuid())
  productionOrderId String   @map("production_order_id")
  batchNumber       String   @unique @map("batch_number")
  quantity          Int
  producedAt        DateTime @default(now()) @map("produced_at")
  notes             String?

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@map("production_batches")
}

model ProductionConsumption {
  id                String  @id @default(uuid())
  productionOrderId String  @map("production_order_id")
  rawMaterialId     String  @map("raw_material_id")
  plannedQty        Decimal @map("planned_qty") @db.Decimal(15, 3)
  actualQty         Decimal @default(0) @map("actual_qty") @db.Decimal(15, 3)
  wasteQty          Decimal @default(0) @map("waste_qty") @db.Decimal(15, 3)
  unit              String  @default("pcs")

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  rawMaterial     RawMaterial     @relation(fields: [rawMaterialId], references: [id])

  @@map("production_consumption")
}

// ==================== QUALITY CONTROL ====================

model QualityInspection {
  id                String        @id @default(uuid())
  companyId         String        @map("company_id")
  inspectionNo      String        @map("inspection_no")
  type              String
  goodsReceiptId    String?       @map("goods_receipt_id")
  productionOrderId String?       @map("production_order_id")
  productId         String?       @map("product_id")
  inspectorId       String?       @map("inspector_id")
  status            QualityStatus @default(PENDING)
  result            String?       @db.Text
  defectsFound      Int           @default(0) @map("defects_found")
  correctiveAction  String?       @map("corrective_action") @db.Text
  inspectedAt       DateTime?     @map("inspected_at")
  createdAt         DateTime      @default(now()) @map("created_at")

  goodsReceipt    GoodsReceipt?    @relation(fields: [goodsReceiptId], references: [id])
  productionOrder ProductionOrder? @relation(fields: [productionOrderId], references: [id])
  product         Product?         @relation(fields: [productId], references: [id])

  @@unique([companyId, inspectionNo])
  @@index([companyId, status])
  @@index([productId, status])
  @@map("quality_inspections")
}

// ==================== SALES ====================

model SalesQuotation {
  id           String         @id @default(uuid())
  companyId    String         @map("company_id")
  quotationNo  String         @map("quotation_no")
  customerId   String         @map("customer_id")
  validUntil   DateTime?      @map("valid_until")
  status       ApprovalStatus @default(DRAFT)
  subtotal     Decimal        @default(0) @db.Decimal(15, 2)
  taxAmount    Decimal        @default(0) @map("tax_amount") @db.Decimal(15, 2)
  totalAmount  Decimal        @default(0) @map("total_amount") @db.Decimal(15, 2)
  notes        String?        @db.Text
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  customer   Customer        @relation(fields: [customerId], references: [id])
  items      QuotationItem[]
  salesOrders SalesOrder[]

  @@unique([companyId, quotationNo])
  @@map("sales_quotations")
}

model QuotationItem {
  id           String  @id @default(uuid())
  quotationId  String  @map("quotation_id")
  productId    String  @map("product_id")
  quantity     Int
  unitPrice    Decimal @map("unit_price") @db.Decimal(15, 2)
  discount     Decimal @default(0) @db.Decimal(5, 2)
  totalPrice   Decimal @map("total_price") @db.Decimal(15, 2)

  quotation SalesQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id])

  @@map("quotation_items")
}

model SalesOrder {
  id           String      @id @default(uuid())
  companyId    String      @map("company_id")
  orderNumber  String      @map("order_number")
  customerId   String      @map("customer_id")
  quotationId  String?     @map("quotation_id")
  createdById   String      @map("created_by_id")
  salesPersonId String?     @map("sales_person_id")
  orderDate    DateTime    @default(now()) @map("order_date")
  requiredDate DateTime?   @map("required_date")
  status       OrderStatus @default(PENDING)
  subtotal     Decimal     @default(0) @db.Decimal(15, 2)
  taxAmount    Decimal     @default(0) @map("tax_amount") @db.Decimal(15, 2)
  totalAmount  Decimal     @default(0) @map("total_amount") @db.Decimal(15, 2)
  /** Customer's own purchase order / LPO number — shown on sales invoices. */
  customerPoNumber String? @map("customer_po_number")
  notes        String?     @db.Text
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  customer         Customer          @relation(fields: [customerId], references: [id])
  quotation        SalesQuotation?   @relation(fields: [quotationId], references: [id])
  createdBy        User              @relation("SalesOrderCreator", fields: [createdById], references: [id])
  salesPerson      User?             @relation("SalesOrderSalesPerson", fields: [salesPersonId], references: [id])
  items            SalesOrderItem[]
  productionOrders ProductionOrder[]
  invoices         Invoice[]
  deliveries       DeliveryNote[]
  salesReturns     SalesReturn[]

  @@unique([companyId, orderNumber])
  @@index([status])
  @@index([customerId])
  @@index([orderDate])
  @@index([salesPersonId])
  @@map("sales_orders")
}

model SalesOrderItem {
  id           String  @id @default(uuid())
  salesOrderId String  @map("sales_order_id")
  productId    String  @map("product_id")
  quantity     Int
  deliveredQty Int     @default(0) @map("delivered_qty")
  unitPrice    Decimal @map("unit_price") @db.Decimal(15, 2)
  discount     Decimal @default(0) @db.Decimal(5, 2)
  totalPrice   Decimal @map("total_price") @db.Decimal(15, 2)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@map("sales_order_items")
}

model SalesTarget {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  salesPersonId String   @map("user_id")
  year          Int
  month         Int
  targetAmount  Decimal  @map("target_amount") @db.Decimal(15, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  salesPerson User @relation(fields: [salesPersonId], references: [id], onDelete: Cascade)

  @@unique([salesPersonId, year, month])
  @@map("sales_targets")
}

// ==================== DELIVERY ====================

model Vehicle {
  id           String      @id @default(uuid())
  companyId    String      @map("company_id")
  registration String
  type         VehicleType @default(TRUCK)
  make         String?
  model        String?
  capacity     String?
  isHired      Boolean     @default(false) @map("is_hired")
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")

  deliveries DeliveryNote[]
  trips      DeliveryTrip[]

  @@unique([companyId, registration])
  @@map("vehicles")
}

model DeliveryTrip {
  id            String         @id @default(uuid())
  companyId     String         @map("company_id")
  tripNo        String         @map("trip_no")
  vehicleId     String?        @map("vehicle_id")
  driverId      String?        @map("driver_id")
  /** Optional carrier / hired-transport waybill reference. */
  waybillNo     String?        @map("waybill_no")
  status        DeliveryStatus @default(PENDING)
  scheduledDate DateTime?      @map("scheduled_date")
  notes         String?        @db.Text
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  vehicle Vehicle?       @relation(fields: [vehicleId], references: [id])
  driver  User?          @relation("DeliveryTripDriver", fields: [driverId], references: [id])
  stops   DeliveryNote[]

  @@unique([companyId, tripNo])
  @@map("delivery_trips")
}

model DeliveryNote {
  id           String         @id @default(uuid())
  companyId    String         @map("company_id")
  deliveryNo   String         @map("delivery_no")
  salesOrderId String         @map("sales_order_id")
  deliveryTripId String?      @map("delivery_trip_id")
  stopSequence Int?           @map("stop_sequence")
  vehicleId    String?        @map("vehicle_id")
  driverId     String?        @map("driver_id")
  /** Optional waybill / consignment note (common for hired trucks). */
  waybillNo    String?        @map("waybill_no")
  status       DeliveryStatus @default(PENDING)
  scheduledDate DateTime?     @map("scheduled_date")
  deliveredAt  DateTime?      @map("delivered_at")
  proofOfDelivery String?     @map("proof_of_delivery")
  notes        String?        @db.Text
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  salesOrder   SalesOrder    @relation(fields: [salesOrderId], references: [id])
  deliveryTrip DeliveryTrip? @relation(fields: [deliveryTripId], references: [id])
  vehicle      Vehicle?      @relation(fields: [vehicleId], references: [id])
  driver       User?         @relation("DeliveryDriver", fields: [driverId], references: [id])
  items        DeliveryItem[]
  invoices     Invoice[]
  salesReturns SalesReturn[]

  @@unique([companyId, deliveryNo])
  @@index([companyId])
  @@map("delivery_notes")
}

model DeliveryItem {
  id             String @id @default(uuid())
  deliveryNoteId String @map("delivery_note_id")
  productId      String @map("product_id")
  quantity       Int

  deliveryNote DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)

  @@map("delivery_items")
}

model SalesReturn {
  id                String   @id @default(uuid())
  companyId         String   @map("company_id")
  returnNo          String   @map("return_no")
  salesOrderId      String   @map("sales_order_id")
  deliveryNoteId    String   @map("delivery_note_id")
  originalInvoiceId String?  @map("original_invoice_id")
  creditNoteId      String?  @unique @map("credit_note_id")
  reason            String   @db.Text
  status            String   @default("COMPLETED")
  createdById       String   @map("created_by_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  salesOrder      SalesOrder        @relation(fields: [salesOrderId], references: [id])
  deliveryNote    DeliveryNote      @relation(fields: [deliveryNoteId], references: [id])
  originalInvoice Invoice?          @relation("SalesReturnOriginalInvoice", fields: [originalInvoiceId], references: [id])
  creditNote      Invoice?          @relation("SalesReturnCreditNote", fields: [creditNoteId], references: [id])
  createdBy       User              @relation("SalesReturnCreator", fields: [createdById], references: [id])
  items           SalesReturnItem[]

  @@unique([companyId, returnNo])
  @@index([companyId])
  @@index([salesOrderId])
  @@index([deliveryNoteId])
  @@map("sales_returns")
}

model SalesReturnItem {
  id            String  @id @default(uuid())
  salesReturnId String  @map("sales_return_id")
  productId     String  @map("product_id")
  quantity      Int
  unitPrice     Decimal @map("unit_price") @db.Decimal(15, 2)
  totalPrice    Decimal @map("total_price") @db.Decimal(15, 2)

  salesReturn SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])

  @@map("sales_return_items")
}

// ==================== FINANCE ====================

model Account {
  id          String      @id @default(uuid())
  companyId   String      @map("company_id")
  code        String
  name        String
  type        AccountType
  parentId    String?     @map("parent_id")
  balance     Decimal     @default(0) @db.Decimal(15, 2)
  isActive    Boolean     @default(true) @map("is_active")
  description String?     @db.Text
  createdAt   DateTime    @default(now()) @map("created_at")

  parent   Account?       @relation("AccountHierarchy", fields: [parentId], references: [id])
  children Account[]      @relation("AccountHierarchy")
  journalEntries JournalEntryLine[]
  expenses Expense[] @relation("ExpenseCategoryAccount")

  @@unique([companyId, code])
  @@map("accounts")
}

model JournalEntry {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  entryNumber  String   @map("entry_number")
  date         DateTime @default(now())
  description  String?  @db.Text
  reference    String?
  sourceType   String?  @map("source_type")
  sourceId     String?  @map("source_id")
  reversalOfId String?  @map("reversal_of_id")
  isPosted     Boolean  @default(false) @map("is_posted")
  createdAt    DateTime @default(now()) @map("created_at")

  lines JournalEntryLine[]

  @@unique([companyId, entryNumber])
  @@index([companyId, sourceType, sourceId])
  @@index([reversalOfId])
  @@map("journal_entries")
}

model JournalEntryLine {
  id             String  @id @default(uuid())
  journalEntryId String  @map("journal_entry_id")
  accountId      String  @map("account_id")
  debit          Decimal @default(0) @db.Decimal(15, 2)
  credit         Decimal @default(0) @db.Decimal(15, 2)
  description    String?

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])

  @@map("journal_entry_lines")
}

model Invoice {
  id              String        @id @default(uuid())
  companyId       String        @map("company_id")
  invoiceNumber   String        @map("invoice_number")
  type            InvoiceType   @default(SALES)
  customerId      String?       @map("customer_id")
  supplierId      String?       @map("supplier_id")
  salesOrderId    String?       @map("sales_order_id")
  purchaseOrderId String?       @map("purchase_order_id")
  deliveryNoteId  String?       @map("delivery_note_id")
  goodsReceiptId  String?       @map("goods_receipt_id")
  /** For CREDIT_NOTE: the sales invoice being credited. */
  originalInvoiceId String?     @map("original_invoice_id")
  invoiceDate     DateTime      @default(now()) @map("invoice_date")
  dueDate         DateTime?     @map("due_date")
  subtotal        Decimal       @default(0) @db.Decimal(15, 2)
  taxAmount       Decimal       @default(0) @map("tax_amount") @db.Decimal(15, 2)
  customerVatAmount Decimal     @default(0) @map("customer_vat_amount") @db.Decimal(15, 2)
  companyVatAmount Decimal      @default(0) @map("company_vat_amount") @db.Decimal(15, 2)
  totalAmount     Decimal       @default(0) @map("total_amount") @db.Decimal(15, 2)
  paidAmount      Decimal       @default(0) @map("paid_amount") @db.Decimal(15, 2)
  status          PaymentStatus @default(UNPAID)
  /** Customer's purchase order / LPO number for this sales invoice. */
  customerPoNumber String?      @map("customer_po_number")
  notes           String?       @db.Text
  fiscalStatus    FiscalStatus  @default(NOT_REQUIRED) @map("fiscal_status")
  etimsQrCode     String?       @map("etims_qr_code") @db.Text
  etimsControlCode String?      @map("etims_control_code")
  etimsSubmittedAt DateTime?    @map("etims_submitted_at")
  etimsInvoiceNumber String?    @map("etims_invoice_number")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  customer      Customer?      @relation(fields: [customerId], references: [id])
  supplier      Supplier?      @relation("SupplierInvoices", fields: [supplierId], references: [id])
  salesOrder    SalesOrder?    @relation(fields: [salesOrderId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  deliveryNote  DeliveryNote?  @relation(fields: [deliveryNoteId], references: [id])
  goodsReceipt  GoodsReceipt?  @relation(fields: [goodsReceiptId], references: [id])
  originalInvoice Invoice?     @relation("InvoiceCreditNotes", fields: [originalInvoiceId], references: [id])
  creditNotes   Invoice[]      @relation("InvoiceCreditNotes")
  items         InvoiceItem[]
  payments      Payment[]
  mpesaTransactions MpesaTransaction[]
  paymentAllocations PaymentAllocation[]
  salesReturnsAsOriginal SalesReturn[] @relation("SalesReturnOriginalInvoice")
  salesReturnAsCreditNote SalesReturn? @relation("SalesReturnCreditNote")

  @@unique([companyId, invoiceNumber])
  @@index([status])
  @@index([customerId])
  @@index([invoiceDate])
  @@index([dueDate])
  @@index([type])
  @@index([originalInvoiceId])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String  @map("invoice_id")
  description String
  quantity    Decimal @db.Decimal(15, 3)
  unitPrice   Decimal @map("unit_price") @db.Decimal(15, 2)
  taxRate     Decimal @default(16) @map("tax_rate") @db.Decimal(5, 2)
  totalPrice  Decimal @map("total_price") @db.Decimal(15, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Payment {
  id            String        @id @default(uuid())
  companyId     String        @map("company_id")
  paymentNumber String        @map("payment_number")
  invoiceId     String?       @map("invoice_id")
  amount        Decimal       @db.Decimal(15, 2)
  method        PaymentMethod @default(BANK_TRANSFER)
  reference     String?
  paymentDate   DateTime      @default(now()) @map("payment_date")
  notes         String?       @db.Text
  isReconciled  Boolean       @default(false) @map("is_reconciled")
  reconciledAt  DateTime?     @map("reconciled_at")
  bankReference String?       @map("bank_reference")
  reconciledById String?      @map("reconciled_by_id")
  createdAt     DateTime      @default(now()) @map("created_at")

  invoice Invoice? @relation(fields: [invoiceId], references: [id])
  statementLine BankStatementLine?
  mpesaTransaction MpesaTransaction?
  allocations PaymentAllocation[]

  @@unique([companyId, paymentNumber])
  @@map("payments")
}

model PaymentAllocation {
  id        String   @id @default(uuid())
  paymentId String   @map("payment_id")
  invoiceId String   @map("invoice_id")
  amount    Decimal  @db.Decimal(15, 2)
  createdAt DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payment_allocations")
}

// ==================== HR ====================

model Employee {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  userId       String?  @unique @map("user_id")
  employeeNo   String   @map("employee_no")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  email        String?
  phone        String?
  gender       Gender   @default(UNSPECIFIED)
  departmentId String?  @map("department_id")
  branchId     String?  @map("branch_id")
  position     String?
  kraPin       String?  @map("kra_pin")
  nhifNo       String?  @map("nhif_no")
  nssfNo       String?  @map("nssf_no")
  hireDate     DateTime @map("hire_date")
  salary       Decimal  @default(0) @db.Decimal(15, 2)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  user       User?       @relation(fields: [userId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  branch     Branch?     @relation(fields: [branchId], references: [id])
  attendance Attendance[]
  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]
  payrollRecords PayrollRecord[]
  salaryAdvances SalaryAdvance[]

  @@unique([companyId, employeeNo])
  @@map("employees")
}

model Attendance {
  id         String    @id @default(uuid())
  employeeId String    @map("employee_id")
  date       DateTime  @db.Date
  checkIn    DateTime? @map("check_in")
  checkOut   DateTime? @map("check_out")
  status     String    @default("present")
  notes      String?

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@map("attendance")
}

model LeaveRequest {
  id                String      @id @default(uuid())
  employeeId        String      @map("employee_id")
  requestedByUserId String?     @map("requested_by_user_id")
  approvedById      String?     @map("approved_by_id")
  approvedAt        DateTime?   @map("approved_at")
  decisionNote      String?     @map("decision_note") @db.Text
  type              String
  startDate         DateTime    @map("start_date")
  endDate           DateTime    @map("end_date")
  reason            String?     @db.Text
  status            LeaveStatus @default(PENDING)
  createdAt         DateTime    @default(now()) @map("created_at")

  employee    Employee @relation(fields: [employeeId], references: [id])
  requestedBy User?    @relation("LeaveRequestedBy", fields: [requestedByUserId], references: [id])
  approvedBy  User?    @relation("LeaveApprovedBy", fields: [approvedById], references: [id])

  @@index([employeeId, status])
  @@index([requestedByUserId])
  @@map("leave_requests")
}

/** Per-employee leave entitlement for a calendar year (resets each Jan 1 via new year rows). */
model LeaveBalance {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  employeeId   String   @map("employee_id")
  year         Int
  type         String
  entitledDays Decimal  @map("entitled_days") @db.Decimal(8, 1)
  usedDays     Decimal  @default(0) @map("used_days") @db.Decimal(8, 1)
  notes        String?  @db.Text
  updatedById  String?  @map("updated_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  updatedBy User?    @relation("LeaveBalanceUpdatedBy", fields: [updatedById], references: [id])

  @@unique([employeeId, year, type])
  @@index([companyId, year])
  @@map("leave_balances")
}

model PayrollRecord {
  id          String   @id @default(uuid())
  employeeId  String   @map("employee_id")
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  basicSalary Decimal  @map("basic_salary") @db.Decimal(15, 2)
  allowances  Decimal  @default(0) @db.Decimal(15, 2)
  paye        Decimal  @default(0) @db.Decimal(15, 2)
  nssf        Decimal  @default(0) @db.Decimal(15, 2)
  shif        Decimal  @default(0) @db.Decimal(15, 2)
  housingLevy Decimal  @default(0) @map("housing_levy") @db.Decimal(15, 2)
  /** Salary advance recovery for this period (applied to balances when marked paid). */
  advanceDeduction Decimal @default(0) @map("advance_deduction") @db.Decimal(15, 2)
  /** Statutory + advance deductions. */
  deductions  Decimal  @default(0) @db.Decimal(15, 2)
  netPay      Decimal  @map("net_pay") @db.Decimal(15, 2)
  isPaid      Boolean  @default(false) @map("is_paid")
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime @default(now()) @map("created_at")

  employee           Employee @relation(fields: [employeeId], references: [id])
  advanceRepayments  SalaryAdvanceRepayment[]

  @@map("payroll_records")
}

/** Staff salary advance with monthly payroll recovery. */
model SalaryAdvance {
  id                 String              @id @default(uuid())
  companyId          String              @map("company_id")
  employeeId         String              @map("employee_id")
  advanceNo          String              @map("advance_no")
  amount             Decimal             @db.Decimal(15, 2)
  monthlyDeduction   Decimal             @map("monthly_deduction") @db.Decimal(15, 2)
  remainingBalance   Decimal             @map("remaining_balance") @db.Decimal(15, 2)
  totalRepaid        Decimal             @default(0) @map("total_repaid") @db.Decimal(15, 2)
  installments       Int                 @default(1)
  reason             String?             @db.Text
  notes              String?             @db.Text
  status             SalaryAdvanceStatus @default(PENDING)
  deductionStartDate DateTime            @map("deduction_start_date") @db.Date
  requestedAt        DateTime            @default(now()) @map("requested_at")
  approvedAt         DateTime?           @map("approved_at")
  approvedById       String?             @map("approved_by_id")
  rejectedAt         DateTime?           @map("rejected_at")
  rejectionReason    String?             @map("rejection_reason") @db.Text
  disbursedAt        DateTime?           @map("disbursed_at")
  cancelledAt        DateTime?           @map("cancelled_at")
  cancelReason       String?             @map("cancel_reason") @db.Text
  createdById        String?             @map("created_by_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  employee   Employee                @relation(fields: [employeeId], references: [id])
  createdBy  User?                   @relation("SalaryAdvanceCreatedBy", fields: [createdById], references: [id])
  approvedBy User?                   @relation("SalaryAdvanceApprovedBy", fields: [approvedById], references: [id])
  repayments SalaryAdvanceRepayment[]

  @@unique([companyId, advanceNo])
  @@index([companyId, status])
  @@index([employeeId, status])
  @@map("salary_advances")
}

model SalaryAdvanceRepayment {
  id            String                       @id @default(uuid())
  companyId     String                       @map("company_id")
  advanceId     String                       @map("advance_id")
  payrollRecordId String?                    @map("payroll_record_id")
  amount        Decimal                      @db.Decimal(15, 2)
  method        SalaryAdvanceRepaymentMethod @default(PAYROLL)
  /** False = scheduled on unpaid payroll; true = balance reduced & GL posted. */
  isApplied     Boolean                      @default(false) @map("is_applied")
  paidAt        DateTime?                    @map("paid_at")
  notes         String?                      @db.Text
  recordedById  String?                      @map("recorded_by_id")
  createdAt     DateTime                     @default(now()) @map("created_at")

  advance       SalaryAdvance  @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  payrollRecord PayrollRecord? @relation(fields: [payrollRecordId], references: [id], onDelete: SetNull)
  recordedBy    User?          @relation("SalaryAdvanceRepaymentRecordedBy", fields: [recordedById], references: [id])

  @@unique([payrollRecordId, advanceId])
  @@index([companyId, advanceId])
  @@index([payrollRecordId])
  @@map("salary_advance_repayments")
}

// ==================== MAINTENANCE ====================

model MaintenanceRequest {
  id          String            @id @default(uuid())
  machineId   String            @map("machine_id")
  type        String
  description String            @db.Text
  status      MaintenanceStatus @default(SCHEDULED)
  scheduledDate DateTime?       @map("scheduled_date")
  completedDate DateTime?       @map("completed_date")
  cost        Decimal           @default(0) @db.Decimal(15, 2)
  notes       String?           @db.Text
  createdAt   DateTime          @default(now()) @map("created_at")

  machine Machine @relation(fields: [machineId], references: [id])

  @@map("maintenance_requests")
}

// ==================== BANK RECONCILIATION & PAYMENTS ====================

model BankStatement {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  statementNumber String   @map("statement_number")
  bankAccountCode String   @default("1100") @map("bank_account_code")
  periodStart     DateTime @map("period_start")
  periodEnd       DateTime @map("period_end")
  openingBalance  Decimal  @default(0) @map("opening_balance") @db.Decimal(15, 2)
  closingBalance  Decimal  @default(0) @map("closing_balance") @db.Decimal(15, 2)
  importedAt      DateTime @default(now()) @map("imported_at")
  notes           String?  @db.Text

  lines BankStatementLine[]

  @@unique([companyId, statementNumber])
  @@map("bank_statements")
}

model BankStatementLine {
  id               String              @id @default(uuid())
  statementId      String              @map("statement_id")
  transactionDate  DateTime            @map("transaction_date")
  description      String?
  reference        String?
  amount           Decimal             @db.Decimal(15, 2)
  matchStatus      BankLineMatchStatus @default(UNMATCHED) @map("match_status")
  matchedPaymentId String?             @unique @map("matched_payment_id")
  createdAt        DateTime            @default(now()) @map("created_at")

  statement      BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  matchedPayment Payment?      @relation(fields: [matchedPaymentId], references: [id])

  @@map("bank_statement_lines")
}

model MpesaTransaction {
  id                 String                 @id @default(uuid())
  companyId          String                 @map("company_id")
  invoiceId          String?                @map("invoice_id")
  phone              String
  amount             Decimal                @db.Decimal(15, 2)
  checkoutRequestId  String?                @unique @map("checkout_request_id")
  merchantRequestId  String?                @map("merchant_request_id")
  mpesaReceiptNumber String?                @map("mpesa_receipt_number")
  status             MpesaTransactionStatus @default(PENDING)
  resultCode         String?                @map("result_code")
  resultDesc         String?                @map("result_desc") @db.Text
  paymentId          String?                @unique @map("payment_id")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  invoice Invoice? @relation(fields: [invoiceId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@map("mpesa_transactions")
}

// ==================== ENTERPRISE PLATFORM ====================

model UserSsoIdentity {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  userId    String   @map("user_id")
  provider  String
  subject   String
  email     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@unique([userId, provider])
  @@index([companyId, email])
  @@map("user_sso_identities")
}

/** Transactional outbox for reliable domain events. */
model OutboxEvent {
  id            String    @id @default(uuid())
  companyId     String    @map("company_id")
  eventType     String    @map("event_type")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  payload       Json
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  availableAt   DateTime  @default(now()) @map("available_at")
  publishedAt   DateTime? @map("published_at")
  lastError     String?   @map("last_error") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([status, availableAt])
  @@index([companyId, eventType, createdAt])
  @@map("outbox_events")
}

/** Lightweight approval workflow for key documents. */
model ApprovalRequest {
  id           String    @id @default(uuid())
  companyId    String    @map("company_id")
  entityType   String    @map("entity_type")
  entityId     String    @map("entity_id")
  title        String
  status       String    @default("PENDING")
  requestedById String   @map("requested_by_id")
  decidedById  String?   @map("decided_by_id")
  decisionNote String?   @map("decision_note") @db.Text
  decidedAt    DateTime? @map("decided_at")
  metadata     Json?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  requestedBy User  @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  decidedBy   User? @relation("ApprovalDecidedBy", fields: [decidedById], references: [id])

  @@index([companyId, status, createdAt])
  @@index([entityType, entityId])
  @@map("approval_requests")
}

model Expense {
  id                 String        @id @default(uuid())
  companyId          String        @map("company_id")
  expenseNumber      String        @map("expense_number")
  expenseDate        DateTime      @default(now()) @map("expense_date")
  categoryAccountId  String        @map("category_account_id")
  payeeName          String        @map("payee_name")
  supplierId         String?       @map("supplier_id")
  description        String        @db.Text
  amount             Decimal       @db.Decimal(15, 2)
  vatAmount          Decimal       @default(0) @map("vat_amount") @db.Decimal(15, 2)
  totalAmount        Decimal       @map("total_amount") @db.Decimal(15, 2)
  paymentMethod      String        @default("CASH") @map("payment_method")
  status             ExpenseStatus @default(DRAFT)
  receiptUrl         String?       @map("receipt_url")
  reference          String?
  notes              String?       @db.Text
  rejectionReason    String?       @map("rejection_reason") @db.Text
  submittedById      String        @map("submitted_by_id")
  approvedById       String?       @map("approved_by_id")
  approvedAt         DateTime?     @map("approved_at")
  postedAt           DateTime?     @map("posted_at")
  journalEntryId     String?       @map("journal_entry_id")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  deletedAt          DateTime?     @map("deleted_at")

  categoryAccount Account  @relation("ExpenseCategoryAccount", fields: [categoryAccountId], references: [id])
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  submittedBy     User     @relation("ExpenseSubmittedBy", fields: [submittedById], references: [id])
  approvedBy      User?    @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])

  @@unique([companyId, expenseNumber])
  @@index([companyId, status, expenseDate])
  @@index([categoryAccountId])
  @@map("expenses")
}
