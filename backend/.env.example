DATABASE_URL="mysql://erp_user:erp_password@localhost:3306/filter_erp"
JWT_SECRET="dev-jwt-secret-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="dev-refresh-secret-change-in-production-min-32"
# 32+ char secret or 64-char hex — encrypts 2FA secrets at rest
DATA_ENCRYPTION_KEY="dev-encryption-key-change-in-production-32b"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Platform owner tenant (registers new companies; demo data lives here only)
PLATFORM_COMPANY_SLUG=owner
PLATFORM_OWNER_EMAIL=kimutaicosmas547@gmail.com
PLATFORM_OWNER_PASSWORD=Kimutai@44!
# Comma-separated extra CORS origins (e.g. https://your-app.trycloudflare.com)
CORS_EXTRA_ORIGINS=
UPLOAD_DIR=./uploads
REPORT_DIR=./reports
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ApexCore ERP <noreply@apexcore.co.ke>"

# M-Pesa Daraja (set MPESA_ENV=stub for local dev without credentials)
MPESA_ENV=stub
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://localhost:3001/api/v1/finance/mpesa/callback
# Optional shared secret sent as X-Mpesa-Callback-Secret header on STK callbacks
MPESA_CALLBACK_SECRET=

# Optional error monitoring (npm install @sentry/node when enabling)
SENTRY_DSN=

# Swagger UI — disabled in production unless true
SWAGGER_ENABLED=false

# Server timezone (IANA)
TZ=Africa/Nairobi

# KRA eTIMS / iTax (optional — stub mode when unset)
KRA_ETIMS_API_URL=
KRA_ETIMS_CLIENT_ID=
KRA_ETIMS_CLIENT_SECRET=
KRA_ETIMS_PIN=
