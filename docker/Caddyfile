# MTE ERP demo — container mte-demo-web on shared Docker network demo_edge (see DEMO_SUBDOMAIN.md)
demo.abexcore.co.ke {
	@sse path /api/events/*
	handle @sse {
		reverse_proxy mte-demo-web:80 {
			flush_interval -1
			transport http {
				read_timeout 24h
				write_timeout 24h
				dial_timeout 10s
			}
		}
	}
	handle {
		encode gzip
		reverse_proxy mte-demo-web:80
	}
}

abexcore.co.ke, www.abexcore.co.ke {
	# Long-lived SSE must not be gzip-buffered; flush immediately.
	@sse path /api/v1/realtime/events
	handle @sse {
		reverse_proxy frontend:80 {
			flush_interval -1
			transport http {
				read_timeout 24h
				write_timeout 24h
				dial_timeout 10s
			}
		}
	}

	handle {
		encode gzip
		reverse_proxy frontend:80
	}
}
