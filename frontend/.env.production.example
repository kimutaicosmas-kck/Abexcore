# Leave empty for same-origin deploy (Docker/nginx).
# For split hosting set to your API URL, e.g.:
# VITE_API_URL=https://erp-api-production.up.railway.app/api/v1

# Sign out after this many minutes without mouse/keyboard activity (default 30).
# VITE_INACTIVITY_TIMEOUT_MINUTES=30
# VITE_INACTIVITY_WARNING_MINUTES=2
