# AbexCore ERP v2.1 — Environment Configuration
# Copy to backend/.env and adjust values

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=mysql://erp_user:erp_password@localhost:3306/filter_erp

# Multi-tenant load (production / Docker — optional locally)
# CLUSTER_WORKERS=4
# REDIS_URL=redis://127.0.0.1:6379
# DB_POOL_CONNECTION_LIMIT=10
# DB_POOL_TIMEOUT=20
# DB_CONNECT_TIMEOUT=10
# RATE_LIMIT_AUTH_MAX=10000
# RATE_LIMIT_ANON_MAX=3000

# JWT (change in production!)
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File storage
UPLOAD_DIR=./uploads
REPORT_DIR=./reports

# Email notifications (optional — leave blank to disable)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AbexCore ERP <noreply@abexcore.co.ke>
