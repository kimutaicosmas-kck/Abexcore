# ApexCore ERP v2.1 — Environment Configuration
# Copy to backend/.env and adjust values

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=mysql://erp_user:erp_password@localhost:3306/filter_erp

# JWT (change in production!)
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File storage
UPLOAD_DIR=./uploads
REPORT_DIR=./reports

# Email notifications (optional — leave blank to disable)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ApexCore ERP <noreply@apexcore.co.ke>
