# AbexCore ERP — Contabo / production (abexcore.co.ke)
# Copy to .env on the server:  cp .env.production.example .env

PUBLIC_URL=https://abexcore.co.ke
FRONTEND_URL=https://abexcore.co.ke
CORS_EXTRA_ORIGINS=https://www.abexcore.co.ke

# Bind app nginx to localhost only — Caddy terminates HTTPS on 80/443
FRONTEND_HOST_BIND=127.0.0.1:8080

NODE_ENV=production
TZ=Africa/Nairobi

# Strong secrets (generated by scripts/contabo-prod-setup.sh if left as CHANGE_ME)
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS
DATA_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_ENCRYPTION_KEY_HERE

MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=filter_erp
MYSQL_USER=erp_user
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD

SEED_ON_START=true
SEED_PRODUCTION=true
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
PLATFORM_COMPANY_SLUG=owner
PLATFORM_OWNER_EMAIL=admin@abexcore.co.ke
PLATFORM_OWNER_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AbexCore ERP <noreply@abexcore.co.ke>

MPESA_ENV=stub
SWAGGER_ENABLED=false
# Fresh Contabo/MySQL has no baseline migration history — push schema from prisma/schema.prisma
USE_DB_PUSH=true
